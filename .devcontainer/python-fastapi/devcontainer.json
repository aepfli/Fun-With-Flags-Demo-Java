// Python (FastAPI) Codespace. Slim Python 3.12 base + Docker-in-Docker so
// the local docker-compose.yaml (flagd on 8013-8016) runs inside the
// Codespace. Opens directly in the python-fastapi/ folder. postCreate
// builds the .venv the README's `.venv/bin/uvicorn` command expects.
{
  "name": "Fun With Flags · Python (FastAPI)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12",
  "workspaceFolder": "/workspaces/Fun-With-Flags-Demo/python-fastapi",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [8080, 8013, 8014, 8015, 8016, 3000, 4317, 4318],
  "portsAttributes": {
    "8080": { "label": "App" },
    "8013": { "label": "flagd gRPC eval" },
    "8014": { "label": "flagd management/metrics" },
    "8015": { "label": "flagd sync (IN_PROCESS)" },
    "8016": { "label": "flagd OFREP" },
    "3000": { "label": "Grafana" },
    "4317": { "label": "OTLP gRPC" },
    "4318": { "label": "OTLP HTTP" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "humao.rest-client"]
    }
  },
  "postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -e . || true"
}
